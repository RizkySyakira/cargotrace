{
	"info": {
		"_postman_id": "cargotrace-api-v1-collection",
		"name": "CargoTrace REST API v1",
		"description": "Postman Collection for CargoTrace: Global Shipment Visibility & Tracking Platform (Final Project UAS Web Programming 2). Covers Authentication via Laravel Sanctum, Public Telemetry, Protected Shipment Management, and Operator Exception Workflows.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "sample_tracking_number",
			"value": "CRG-2026-0001",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication (Slide 12)",
			"item": [
				{
					"name": "Login (Operator / Admin / Customer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"operator@cargotrace.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticates credentials and returns a Bearer token generated by Laravel Sanctum. Copy the token into the collection variable {{bearer_token}}."
					},
					"response": []
				},
				{
					"name": "Current User Profile (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"me"
							]
						},
						"description": "Protected endpoint returning the profile of the currently authenticated token owner."
					},
					"response": []
				},
				{
					"name": "Logout (Token Revocation)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Deletes the current personal access token from database."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Public Telemetry (No Token)",
			"item": [
				{
					"name": "Public Track by Tracking Number",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/public/track/{{sample_tracking_number}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"public",
								"track",
								"{{sample_tracking_number}}"
							]
						},
						"description": "Public endpoint accessible without authentication. Returns shipment details, route waypoints, container items, and real-time Open-Meteo satellite weather."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Shipments Management (Protected)",
			"item": [
				{
					"name": "List Shipments (Customer Scoped & Filtered)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/shipments?status=IN_TRANSIT&delay_status=ON_TIME",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shipments"
							],
							"query": [
								{
									"key": "status",
									"value": "IN_TRANSIT",
									"description": "Filter by status: CREATED, BOOKED, PICKED_UP, IN_TRANSIT, DELIVERED"
								},
								{
									"key": "delay_status",
									"value": "ON_TIME",
									"description": "Filter by delay: ON_TIME, DELAYED"
								}
							]
						},
						"description": "Returns paginated shipments list. Enforces Slide 13 Authorization: Customers only see their own company shipments."
					},
					"response": []
				},
				{
					"name": "Show Shipment Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/shipments/{{sample_tracking_number}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shipments",
								"{{sample_tracking_number}}"
							]
						},
						"description": "Fetches complete shipment dossier including containers, full checkpoints timeline, and exceptions. Rejects with 403 Forbidden if Customer attempts to access a competitor's shipment."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Field Operations (Operator / Admin)",
			"item": [
				{
					"name": "Record Journey Checkpoint (Append-Only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"location_name\": \"Malacca Strait Outbound Fairway\",\n    \"event_type\": \"IN_TRANSIT\",\n    \"description\": \"Vessel passed TSS traffic checkpoint at 15.2 knots cruising speed.\",\n    \"latitude\": 1.4500000,\n    \"longitude\": 103.5000000,\n    \"event_time\": \"2026-11-16 12:00:00\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/shipments/{{sample_tracking_number}}/checkpoints",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shipments",
								"{{sample_tracking_number}}",
								"checkpoints"
							]
						},
						"description": "Allows Logistics Operator to append a new physical waypoint. Automatically queries Open-Meteo Satellite API based on latitude/longitude."
					},
					"response": []
				},
				{
					"name": "Report Operational Exception & Adjust ETA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"exception_type\": \"PORT_CONGESTION\",\n    \"severity\": \"MEDIUM\",\n    \"description\": \"Berthing delayed due to high container traffic at terminal.\",\n    \"additional_delay_hours\": 24\n}"
						},
						"url": {
							"raw": "{{base_url}}/shipments/{{sample_tracking_number}}/exceptions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shipments",
								"{{sample_tracking_number}}",
								"exceptions"
							]
						},
						"description": "Reports operational disruption. Automatically triggers EtaService to recalculate arrival time and delay severity."
					},
					"response": []
				}
			]
		}
	]
}
